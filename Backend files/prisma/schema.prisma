generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "mysql"
  url      = env("DATABASE_URL")
}

model User {
  id        String   @id @default(uuid())
  firstName String
  lastName  String
  email     String   @unique
  role      Role     @default(USER)
  password  String
  createdAt DateTime @default(now()) @db.DateTime(3)
  updatedAt DateTime @updatedAt @db.DateTime(3)

  settings    Setting?
  plans       Plan[]
  customers   Customer[]
  payments    Payment[]
  projections Projection[]

  @@map("users")
}

model Setting {
  id            String  @id @default(uuid())
  userId        String  @unique
  workspaceName String  @default("My Workspace")
  darkMode      Boolean @default(false)
  language      String  @default("en-US")
  notifications Boolean @default(true)
  currency      String  @default("NGN")
  createdAt     DateTime @default(now()) @db.DateTime(3)
  updatedAt     DateTime @updatedAt @db.DateTime(3)

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@map("settings")
}

model Plan {
  id           String   @id @default(uuid())
  userId       String
  name         String
  price        Decimal  @db.Decimal(12, 2)
  durationDays Int
  status       PlanStatus @default(ACTIVE)
  createdAt    DateTime @default(now()) @db.DateTime(3)
  updatedAt    DateTime @updatedAt @db.DateTime(3)

  user        User         @relation(fields: [userId], references: [id], onDelete: Cascade)
  customers   Customer[]
  payments    Payment[]
  projections Projection[]

  @@unique([userId, name])
  @@index([userId])
  @@map("plans")
}

enum PlanStatus {
  ACTIVE
  ARCHIVED
}

model Customer {
  id            String         @id @default(uuid())
  userId        String
  name          String
  email         String?
  phone         String?
  externalId    String?
  planId        String
  expiryDate    DateTime       @db.DateTime(3)
  status        CustomerStatus @default(ACTIVE)
  customerSince DateTime       @default(now()) @db.DateTime(3)
  createdAt     DateTime       @default(now()) @db.DateTime(3)
  updatedAt     DateTime       @updatedAt @db.DateTime(3)

  user     User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  plan     Plan      @relation(fields: [planId], references: [id])
  payments Payment[]

  @@index([userId])
  @@index([expiryDate])
  @@map("customers")
}

enum CustomerStatus {
  ACTIVE
  EXPIRED
  INACTIVE
}

model Payment {
  id          String         @id @default(uuid())
  userId      String
  customerId  String
  planId      String
  amount      Decimal        @db.Decimal(12, 2)
  paymentDate DateTime       @default(now()) @db.DateTime(3)
  method      PaymentMethod
  reference   String
  paymentType     String?
  monthsPaid      Int?
  discountPercent Decimal?       @db.Decimal(5, 2)
  createdAt   DateTime       @default(now()) @db.DateTime(3)
  updatedAt   DateTime       @updatedAt @db.DateTime(3)

  user     User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  customer Customer @relation(fields: [customerId], references: [id])
  plan     Plan     @relation(fields: [planId], references: [id])

  @@unique([userId, reference])
  @@index([userId, paymentDate])
  @@index([userId, planId])
  @@index([customerId])
  @@map("payments")
}

enum PaymentMethod {
  BANK_TRANSFER
  CASH
  POS
}

model Projection {
  id        String   @id @default(uuid())
  userId    String
  planId    String
  date      DateTime @db.Date
  threeDay  Decimal? @db.Decimal(12, 2)
  oneWeek   Decimal? @db.Decimal(12, 2)
  oneMonth  Decimal? @db.Decimal(12, 2)
  oneYear   Decimal? @db.Decimal(12, 2)
  createdAt DateTime @default(now()) @db.DateTime(3)
  updatedAt DateTime @updatedAt @db.DateTime(3)

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
  plan Plan @relation(fields: [planId], references: [id])

  @@unique([userId, planId, date])
  @@index([userId, date])
  @@map("projections")
}

enum Role {
  SUPER_ADMIN
  USER
}
